{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "formatter-policy-request.schema.json",
  "title": "FormatterPolicyRequest",
  "oneOf": [
    {
      "type": "object",
      "required": ["command", "implementation", "context", "language"],
      "properties": {
        "command": {"const": "select"},
        "implementation": {"enum": ["absent", "present", "indeterminate"]},
        "context": {"enum": ["absent", "present", "indeterminate"]},
        "language": {"type": "string", "minLength": 1},
        "repository_formatter": {"type": "string", "minLength": 1},
        "repository_check_argv": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "repository_write_argv": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    {
      "type": "object",
      "required": ["command", "project_root", "scaffold_paths"],
      "properties": {
        "command": {"const": "preflight"},
        "project_root": {"type": "string", "minLength": 1},
        "scaffold_paths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "allowed_existing": {"type": "array", "items": {"type": "string"}}
      }
    },
    {
      "type": "object",
      "required": ["command", "operation", "project_kind", "project_root", "selected_formatter", "selection_status", "preflight_status", "formatter_available", "check_status"],
      "properties": {
        "command": {"const": "gate"},
        "operation": {"enum": ["minimal-scaffold", "product-code"]},
        "project_kind": {"enum": ["greenfield", "existing"]},
        "project_root": {"type": "string", "minLength": 1},
        "selected_formatter": {"type": "string", "minLength": 1},
        "selection_status": {"enum": ["pass", "blocked"]},
        "preflight_status": {"enum": ["pass", "blocked", "not-applicable"]},
        "formatter_available": {"type": "boolean"},
        "check_status": {"enum": ["not-run", "pass", "fail"]},
        "install_requested": {"type": "boolean"},
        "install_authorized": {"type": "boolean"}
      }
    }
  ]
}
