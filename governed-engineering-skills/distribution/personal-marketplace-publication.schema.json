{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ShinWeiPeng/skills/distribution/personal-marketplace-publication.schema.json",
  "title": "Personal Git Marketplace publication record",
  "type": "object",
  "required": [
    "schema_version",
    "channel",
    "repository_url",
    "git_ref",
    "source_commit",
    "source_tag",
    "marketplace_path",
    "sparse_paths",
    "artifact",
    "tree_fingerprint",
    "installation_steps",
    "rollback",
    "evidence_checklist"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "channel": {"const": "personal-git-marketplace"},
    "repository_url": {"const": "https://github.com/ShinWeiPeng/skills.git"},
    "git_ref": {"const": "marketplace-release"},
    "source_commit": {"pattern": "^[0-9a-f]{40}$"},
    "source_tag": {"pattern": "^governed-engineering-skills@[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "marketplace_path": {"const": ".agents/plugins/marketplace.json"},
    "sparse_paths": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "artifact": {
      "type": "object",
      "required": ["name", "version", "content_fingerprint", "inventory"],
      "properties": {
        "name": {"const": "governed-engineering-skills"},
        "version": {"type": "string", "minLength": 1},
        "content_fingerprint": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "inventory": {"const": "plugins/governed-engineering-skills/artifact-inventory.json"}
      },
      "additionalProperties": false
    },
    "tree_fingerprint": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "installation_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollback": {
      "type": "object",
      "required": ["method", "previous_publication_commit"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "previous_publication_commit": {"pattern": "^([0-9a-f]{40}|none:first-publication)$"}
      },
      "additionalProperties": false
    },
    "evidence_checklist": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
