{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project AC verification mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spec_id",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "spec_id": {
      "type": "string",
      "pattern": "^SPEC-[0-9]{4}$"
    },
    "acceptance": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^AC-[0-9]{3}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_claims",
          "rationale"
        ],
        "properties": {
          "criterion_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_claims": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "host-semantics",
                "adapter-conformance",
                "controlled-target-cost",
                "production-timing",
                "physical-integration",
                "system-stability",
                "hard-real-time",
                "soft-real-time"
              ]
            }
          },
          "contract_dimensions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "execution_changes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "scenario_layers": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "pil",
                "hil",
                "system-soak"
              ]
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          },
          "build_artifact": {
            "type": "string",
            "minLength": 1
          },
          "enablement_scenarios": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
