{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/governed-engineering/verification-ladder.schema.json",
  "title": "Project verification ladder matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "architecture_manifest", "layers", "rules"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "architecture_manifest": {"type": "string", "minLength": 1},
    "on_device_profile": {"type": "string", "minLength": 1},
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module-contract": {"$ref": "#/$defs/layerContract"},
        "sil": {"$ref": "#/$defs/layerContract"},
        "adapter-contract": {"$ref": "#/$defs/layerContract"},
        "pil": {"$ref": "#/$defs/layerContract"},
        "hil": {"$ref": "#/$defs/layerContract"},
        "system-soak": {"$ref": "#/$defs/layerContract"}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    },
    "not_applicable": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "rationale"],
        "properties": {
          "layer": {"enum": ["module-contract", "sil", "adapter-contract", "pil", "hil", "system-soak"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "layerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "inputs", "metrics", "thresholds", "evidence", "stop_condition", "next_layers"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "inputs": {"$ref": "#/$defs/nonEmptyStrings"},
        "metrics": {"$ref": "#/$defs/nonEmptyStrings"},
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "fail", "blocked"],
          "properties": {
            "pass": {"type": "string", "minLength": 1},
            "fail": {"type": "string", "minLength": 1},
            "blocked": {"type": "string", "minLength": 1}
          }
        },
        "evidence": {"type": "string", "minLength": 1},
        "stop_condition": {"type": "string", "minLength": 1},
        "next_layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["module-contract", "sil", "adapter-contract", "pil", "hil", "system-soak"]}
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "architecture_refs", "contract_dimensions", "execution_changes", "evidence_claims", "layers", "on_device_scenarios", "execution_profiles"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "architecture_refs": {"$ref": "#/$defs/nonEmptyStrings"},
        "contract_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["input-output-units", "state-transition", "call-order", "error-reset", "batch-capacity", "throughput-backlog", "latency-resource", "external-port"]}
        },
        "execution_changes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["target-code", "core-mapping", "scheduler", "interrupt", "peripheral-traffic", "synchronization", "competing-workload", "physical-hardware", "transport-protocol", "logging"]}
        },
        "evidence_claims": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["host-semantics", "adapter-conformance", "controlled-target-cost", "production-timing", "physical-integration", "system-stability", "hard-real-time", "soft-real-time"]}
        },
        "layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["module-contract", "sil", "adapter-contract", "pil", "hil", "system-soak"]}
        },
        "on_device_scenarios": {"$ref": "#/$defs/nonEmptyStrings"},
        "execution_profiles": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    }
  }
}
