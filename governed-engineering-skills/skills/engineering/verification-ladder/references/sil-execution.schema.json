{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Executed production-module SIL report",
  "type": "object",
  "required": [
    "layer",
    "ac",
    "plan_sha256",
    "verdict",
    "complete",
    "command",
    "exit_code",
    "modules"
  ],
  "properties": {
    "layer": {
      "const": "sil"
    },
    "ac": {
      "type": "string",
      "minLength": 1
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "complete": {
      "const": true
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "exit_code": {
      "type": "integer"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "public_interfaces",
          "cases",
          "production_sources",
          "external_dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "public_interfaces": {
            "$ref": "#/$defs/names"
          },
          "cases": {
            "$ref": "#/$defs/names"
          },
          "production_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "external_dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "interface",
                "mode"
              ],
              "properties": {
                "interface": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "mode": {
                  "enum": [
                    "fake",
                    "replay",
                    "real"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    }
  ]
}
